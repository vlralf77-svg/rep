generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Team {
  id         Int      @id
  name       String
  shortName  String
  crest      String
  eloRating  Float    @default(1500)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  homeMatches Match[] @relation("HomeTeam")
  awayMatches Match[] @relation("AwayTeam")
  standings   Standing[]
}

model Match {
  id          Int      @id
  homeTeamId  Int
  awayTeamId  Int
  utcDate     DateTime
  status      String
  matchday    Int?
  stage       String?
  groupName   String?
  competitionId Int
  competitionName String
  competitionCode String
  homeScore   Int?
  awayScore   Int?
  htHomeScore Int?
  htAwayScore Int?
  winner      String?
  lastUpdated DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  homeTeam    Team     @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam    Team     @relation("AwayTeam", fields: [awayTeamId], references: [id])

  @@index([status])
  @@index([utcDate])
  @@index([competitionCode])
}

model Standing {
  id            Int      @id @default(autoincrement())
  teamId        Int
  competitionCode String
  season        String
  position      Int
  playedGames   Int
  won           Int
  draw          Int
  lost          Int
  points        Int
  goalsFor      Int
  goalsAgainst  Int
  goalDifference Int
  form          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  team          Team     @relation(fields: [teamId], references: [id])

  @@unique([teamId, competitionCode, season])
}

model H2H {
  id          Int      @id @default(autoincrement())
  homeTeamId  Int
  awayTeamId  Int
  homeWins    Int      @default(0)
  draws       Int      @default(0)
  awayWins    Int      @default(0)
  homeGoals   Int      @default(0)
  awayGoals   Int      @default(0)
  totalMatches Int     @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([homeTeamId, awayTeamId])
}
